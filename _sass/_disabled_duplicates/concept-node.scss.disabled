
/* ==========================================================================
   PHASE 3: KNOWLEDGE GRAPH VALIDATION STATES
   ========================================================================== */

.neural-node-panel--error {
  border: 1px solid #ef4444;
  background: rgba(239, 68, 68, 0.08);
  padding: 1.5rem;
  border-radius: 8px;
}

.neural-node-panel--error code {
  background: rgba(239, 68, 68, 0.15);
  padding: 0.15rem 0.4rem;
  border-radius: 4px;
  font-weight: 600;
}

.neural-node--missing {
  opacity: 0.7;
  font-style: italic;
}

.neural-node--missing span {
  cursor: help;
  border-bottom: 1px dashed rgba(239, 68, 68, 0.5);
}
