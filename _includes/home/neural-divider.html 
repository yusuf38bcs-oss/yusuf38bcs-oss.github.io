<section class="neural-system-divider" aria-label="Thematic transition section">
  <div class="divider-matrix-inner">

    <div class="divider-node-cluster node-cluster--top" aria-hidden="true">
      <div class="matrix-solid-dot"></div>
      <div class="matrix-horizontal-line"></div>
      <div class="matrix-solid-dot"></div>
    </div>

    <div class="divider-core-message">
      <p class="divider-transition-text">
        From Understanding Biology <span class="cyan-glow-text">to Discovering Your Self</span>
      </p>
    </div>

    <div class="divider-node-cluster node-cluster--middle" aria-hidden="true">
      <div class="matrix-fade-line-left"></div>
      <div class="matrix-hollow-circle"></div>
      <div class="matrix-fade-line-right"></div>
    </div>

  </div>

  <div class="divider-ambient-glow" aria-hidden="true"></div>
</section>

{% unless jekyll_divider_styles_loaded %}
<style>
  .neural-system-divider {
    position: relative;
    width: 100%;
    margin: clamp(4rem, 10vw, 6rem) 0 !important;
    padding: 2rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    overflow: hidden;
    font-family: 'Inter', -apple-system, sans-serif !important;
  }

  .divider-matrix-inner {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    width: 100%;
    max-width: 800px;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  /* Core Geometries Replacing Raw Text Characters */
  .divider-node-cluster {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    user-select: none;
  }

  .matrix-solid-dot {
    width: 6px;
    height: 6px;
    background-color: #00d4b2 !important;
    border-radius: 50%;
    box-shadow: 0 0 10px #00d4b2;
  }

  .matrix-horizontal-line {
    width: 60px;
    height: 1px;
    background: rgba(0, 212, 178, 0.25);
  }

  /* Central Philosophy Typography Optimization */
  .divider-transition-text {
    color: #94a3b8 !important;
    font-size: clamp(0.95rem, 4vw, 1.2rem) !important;
    font-weight: 600 !important;
    letter-spacing: 0.05em !important;
    margin: 0 !important;
    text-align: center !important;
    line-height: 1.5 !important;
    text-transform: uppercase;
  }

  .divider-transition-text .cyan-glow-text {
    color: #ffffff !important;
    display: block;
    font-size: clamp(1.1rem, 5vw, 1.4rem) !important;
    font-weight: 800 !important;
    margin-top: 0.35rem;
    letter-spacing: -0.01em !important;
    text-shadow: 0 0 20px rgba(0, 212, 178, 0.1);
    text-transform: none;
  }

  /* Middle Fading Line Blueprint */
  .matrix-hollow-circle {
    width: 12px;
    height: 12px;
    border: 2px solid #00d4b2 !important;
    border-radius: 50%;
    background-color: #020617 !important;
    box-shadow: 0 0 8px rgba(0, 212, 178, 0.3);
    flex-shrink: 0;
  }

  .matrix-fade-line-left {
    width: 100%;
    max-width: 180px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(0, 212, 178, 0.2) 100%);
  }

  .matrix-fade-line-right {
    width: 100%;
    max-width: 180px;
    height: 1px;
    background: linear-gradient(90deg, rgba(0, 212, 178, 0.2) 0%, transparent 100%);
  }

  /* Ambient Dynamic Visual Glow Canvas */
  .divider-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    height: 100px;
    background: radial-gradient(circle, rgba(0, 212, 178, 0.03) 0%, transparent 70%);
    z-index: 1;
    pointer-events: none;
  }

  /* Responsive Multi-Device Adaptations */
  @media (max-width: 480px) {
    .neural-system-divider {
      margin: 4rem 0 !important;
    }
    .matrix-horizontal-line {
      width: 40px;
    }
    .matrix-fade-line-left, .matrix-fade-line-right {
      max-width: 100px;
    }
  }
</style>
{% assign jekyll_divider_styles_loaded = true %}
{% endunless %}
