        "repair_candidates": "edge",
        "evidence_refs": "edge",
        "unknowns": "edge"
      }
    },
    {
      "id": "remediation_design",
      "class": "reasoning_node",
      "job": "Design the smallest reversible, scope-bounded repair that closes authenticated blockers without weakening validators.",
      "inputs": [
        "authority",
        "scope",
        "repair_candidates",
        "required_gates",
        "evidence_refs"
      ],
      "outputs": [
        "authority",
        "scope",
        "repair_plan",
        "changed_file_boundary",
        "expected_evidence",
        "stop_conditions",
        "required_gates",
        "evidence_refs"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "scope_not_bounded": "HOLD",
        "unsafe_repair": "STOP"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "repair_candidates": "edge",
        "required_gates": "edge",
        "evidence_refs": "edge"
      }
    },
    {
      "id": "isolated_implementation",
      "class": "mutation_node",
      "job": "Implement only the approved repair in an isolated branch/worktree or equivalent non-production candidate.",
      "inputs": [
        "authority",
        "scope",
        "repair_plan",
        "changed_file_boundary",
        "expected_evidence",
        "stop_conditions",
        "required_gates",
        "evidence_refs"
