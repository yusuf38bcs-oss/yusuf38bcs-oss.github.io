        "candidate_head",
        "check_set",
        "route",
        "risk_level",
        "required_gates",
        "repair_candidates",
        "evidence_refs",
        "unknowns",
        "terminal_status",
        "residual_risks"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "unclassifiable_risk": "ESCALATE"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "candidate_head": "edge",
        "check_set": "edge",
