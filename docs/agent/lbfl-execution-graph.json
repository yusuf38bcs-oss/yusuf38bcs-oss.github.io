{
  "version": "1.0.0",
  "name": "LBFL Evidence-Bound Execution Graph",
  "purpose": "Coordinate LBFL research, academic, UI, SEO, accessibility, security, runtime, remediation, certification, and release work with explicit dependencies, durable state, fail-closed gates, and human authority.",
  "defaults": {
    "mutation_allowed": false,
    "evidence_states": ["VERIFIED", "CORROBORATED", "INFERRED", "UNVERIFIED", "CONFLICTED", "BLOCKED", "STALE", "SUPERSEDED", "ABSENT"],
    "failure_routes": ["RETRY", "FALLBACK", "SKIP", "REPAIR", "ESCALATE", "HOLD", "FAIL_CLOSED", "STOP"],
    "max_cycle_rounds": 6,
    "dry_rounds_to_converge": 2
  },
  "nodes": [
    {
      "id": "authenticate_baseline",
      "class": "deterministic_gate",
      "job": "Authenticate current repository, branch, SHA/tree, deployment references, and task scope before downstream work.",
      "inputs": ["mission", "repository_ref", "target_environment"],
      "outputs": ["authority", "scope", "evidence_refs", "status"],
      "mutations": {"allowed": false},
      "failure": {"identity_mismatch": "FAIL_CLOSED", "missing_authority": "HOLD", "transient_tool_failure": "RETRY"}
    },
    {
      "id": "academic_truth_audit",
      "class": "specialist_audit",
      "job": "Audit scientific accuracy, curriculum alignment, source authority, and unresolved academic claims.",
      "inputs": ["authority", "scope"],
      "outputs": ["academic_status", "claims", "evidence_refs", "unresolved_claims"],
      "mutations": {"allowed": false},
      "failure": {"insufficient_evidence": "HOLD", "source_conflict": "ESCALATE", "transient_tool_failure": "RETRY"}
    },
    {
      "id": "ui_responsive_audit",
      "class": "specialist_audit",
      "job": "Audit learner-visible UI, CSS/SCSS architecture, responsive behavior, typography, hierarchy, and interaction quality.",
      "inputs": ["authority", "scope"],
      "outputs": ["ui_status", "findings", "evidence_refs", "candidate_actions"],
      "mutations": {"allowed": false},
      "failure": {"render_unavailable": "RETRY", "identity_mismatch": "FAIL_CLOSED"}
    },
    {
      "id": "seo_route_audit",
      "class": "specialist_audit",
      "job": "Audit routes, canonicals, metadata, language alternates, sitemap behavior, internal linking, and indexability.",
      "inputs": ["authority", "scope"],
      "outputs": ["seo_status", "route_findings", "evidence_refs"],
      "mutations": {"allowed": false},
      "failure": {"route_inventory_incomplete": "HOLD", "transient_tool_failure": "RETRY"}
    },
    {
      "id": "accessibility_audit",
      "class": "specialist_audit",
      "job": "Audit semantics, keyboard/focus, contrast, zoom/reflow, motion, touch targets, overflow, and no-JS resilience.",
      "inputs": ["authority", "scope"],
      "outputs": ["a11y_status", "findings", "evidence_refs"],
      "mutations": {"allowed": false},
      "failure": {"critical_violation": "HOLD", "transient_tool_failure": "RETRY"}
    },
    {
      "id": "security_supply_chain_audit",
      "class": "specialist_audit",
      "job": "Audit secrets exposure, workflow trust boundaries, permissions, dependency pinning, actions provenance, and static security findings.",
      "inputs": ["authority", "scope"],
      "outputs": ["security_status", "findings", "evidence_refs"],
      "mutations": {"allowed": false},
      "failure": {"secret_exposure": "FAIL_CLOSED", "trust_boundary_violation": "FAIL_CLOSED", "transient_tool_failure": "RETRY"}
    },
    {
      "id": "runtime_worker_audit",
      "class": "specialist_audit",
      "job": "Audit Pages/Workers/API deployment identity, routes, provider/model diagnostics, CORS, health, observability, and incident context.",
      "inputs": ["authority", "scope", "target_environment"],
      "outputs": ["runtime_status", "deployment_identity", "worker_identity", "findings", "evidence_refs"],
      "mutations": {"allowed": false},
      "failure": {"runtime_identity_unknown": "HOLD", "provider_incident": "ESCALATE", "transient_tool_failure": "RETRY"}
    },
    {
      "id": "synthesize_findings",
      "class": "deterministic_join",
      "job": "Normalize and join only authenticated audit outputs; preserve unresolved evidence rather than smoothing conflicts.",
      "inputs": ["academic_status", "ui_status", "seo_status", "a11y_status", "security_status", "runtime_status"],
      "outputs": ["synthesis_status", "blockers", "repair_candidates", "evidence_refs", "unknowns"],
      "mutations": {"allowed": false},
      "failure": {"required_branch_missing": "HOLD", "evidence_conflict": "ESCALATE"}
    },
    {
      "id": "risk_router",
      "class": "policy_router",
      "job": "Route the task by authenticated risk and evidence state; model judgment may classify, but allowed routes are deterministic.",
      "inputs": ["synthesis_status", "blockers", "repair_candidates", "unknowns"],
      "outputs": ["route", "risk_level", "required_gates"],
      "mutations": {"allowed": false},
      "failure": {"unclassifiable_risk": "ESCALATE"}
    },
    {
      "id": "remediation_design",
      "class": "reasoning_node",
      "job": "Design the smallest reversible, scope-bounded repair that closes authenticated blockers without weakening validators.",
      "inputs": ["authority", "repair_candidates", "required_gates"],
      "outputs": ["repair_plan", "changed_file_boundary", "expected_evidence", "stop_conditions"],
      "mutations": {"allowed": false},
      "failure": {"scope_not_bounded": "HOLD", "unsafe_repair": "STOP"}
    },
    {
      "id": "isolated_implementation",
      "class": "mutation_node",
      "job": "Implement only the approved repair in an isolated branch/worktree or equivalent non-production candidate.",
      "inputs": ["authority", "repair_plan", "changed_file_boundary"],
      "outputs": ["candidate_head", "candidate_tree", "changed_files", "implementation_artifacts"],
      "mutations": {"allowed": true, "scope": "isolated_candidate_only", "production": false},
      "failure": {"scope_drift": "FAIL_CLOSED", "write_conflict": "RETRY", "permission_boundary": "STOP"}
    },
    {
      "id": "candidate_verification_cycle",
      "class": "controlled_cycle",
      "job": "Run deterministic verification and repair only failing work until PASS, bounded convergence, or escalation.",
      "inputs": ["candidate_head", "changed_files", "expected_evidence"],
      "outputs": ["verification_status", "check_set", "evidence_refs", "failed_checks", "rounds"],
      "mutations": {"allowed": true, "scope": "isolated_candidate_repair_only", "production": false},
      "failure": {"nonconvergence": "ESCALATE", "budget_exhausted": "STOP", "identity_changed": "FAIL_CLOSED"},
      "convergence": {"max_rounds": 6, "dry_rounds": 2}
    },
    {
      "id": "exact_head_certification",
      "class": "deterministic_gate",
      "job": "Bind build, browser/accessibility/security checks, immutable preview, review state, and governance evidence to the exact candidate head/base.",
      "inputs": ["candidate_head", "check_set", "evidence_refs", "required_gates"],
      "outputs": ["certification_status", "exact_head", "exact_base", "preview_identity", "unresolved_threads", "governance_state", "evidence_refs"],
      "mutations": {"allowed": false},
      "failure": {"head_or_base_moved": "FAIL_CLOSED", "required_check_failed": "HOLD", "preview_identity_missing": "HOLD"}
    },
    {
      "id": "human_release_authority",
      "class": "human_gate",
      "job": "Require explicit human authorization for the exact certified candidate before production-impacting action.",
      "inputs": ["certification_status", "exact_head", "exact_base", "governance_state"],
      "outputs": ["authorization_status", "authorized_head", "authorized_scope", "authorization_ref"],
      "mutations": {"allowed": false},
      "failure": {"authorization_missing": "STOP", "head_changed": "FAIL_CLOSED"}
    },
    {
      "id": "production_deployment",
      "class": "mutation_node",
      "job": "Perform only the explicitly authorized production mutation using the certified exact candidate and bounded rollout plan.",
      "inputs": ["authorization_status", "authorized_head", "authorized_scope", "rollback_plan"],
      "outputs": ["deployment_status", "deployment_identity", "runtime_version", "deployment_evidence"],
      "mutations": {"allowed": true, "scope": "explicit_authorization_only", "production": true},
      "failure": {"deployment_error": "RETRY", "identity_mismatch": "FAIL_CLOSED", "permission_boundary": "STOP"}
    },
    {
      "id": "live_certification",
      "class": "deterministic_gate",
      "job": "Verify production domain, deployed identity, critical routes, learner-visible behavior, runtime health, telemetry, and rollback readiness.",
      "inputs": ["deployment_identity", "runtime_version", "deployment_evidence"],
      "outputs": ["live_status", "production_evidence", "residual_risks"],
      "mutations": {"allowed": false},
      "failure": {"critical_live_failure": "ESCALATE", "identity_mismatch": "FAIL_CLOSED"}
    },
    {
      "id": "close_and_persist",
      "class": "state_node",
      "job": "Persist final authoritative state, evidence references, decisions, residual risks, invalidated evidence, and next delta.",
      "inputs": ["live_status", "production_evidence", "residual_risks"],
      "outputs": ["final_state", "continuation_ref"],
      "mutations": {"allowed": false},
      "failure": {"state_persist_failed": "RETRY"}
    }
  ],
  "edges": [
    {"from": "authenticate_baseline", "to": "academic_truth_audit", "condition": "status == VERIFIED", "contract": ["authority", "scope"]},
    {"from": "authenticate_baseline", "to": "ui_responsive_audit", "condition": "status == VERIFIED", "contract": ["authority", "scope"]},
    {"from": "authenticate_baseline", "to": "seo_route_audit", "condition": "status == VERIFIED", "contract": ["authority", "scope"]},
    {"from": "authenticate_baseline", "to": "accessibility_audit", "condition": "status == VERIFIED", "contract": ["authority", "scope"]},
    {"from": "authenticate_baseline", "to": "security_supply_chain_audit", "condition": "status == VERIFIED", "contract": ["authority", "scope"]},
    {"from": "authenticate_baseline", "to": "runtime_worker_audit", "condition": "status == VERIFIED", "contract": ["authority", "scope", "target_environment"]},
    {"from": "academic_truth_audit", "to": "synthesize_findings", "condition": "terminal", "contract": ["academic_status", "unresolved_claims", "evidence_refs"]},
    {"from": "ui_responsive_audit", "to": "synthesize_findings", "condition": "terminal", "contract": ["ui_status", "findings", "evidence_refs"]},
    {"from": "seo_route_audit", "to": "synthesize_findings", "condition": "terminal", "contract": ["seo_status", "route_findings", "evidence_refs"]},
    {"from": "accessibility_audit", "to": "synthesize_findings", "condition": "terminal", "contract": ["a11y_status", "findings", "evidence_refs"]},
    {"from": "security_supply_chain_audit", "to": "synthesize_findings", "condition": "terminal", "contract": ["security_status", "findings", "evidence_refs"]},
    {"from": "runtime_worker_audit", "to": "synthesize_findings", "condition": "terminal", "contract": ["runtime_status", "deployment_identity", "worker_identity", "evidence_refs"]},
    {"from": "synthesize_findings", "to": "risk_router", "condition": "synthesis_status in [VERIFIED,CORROBORATED,BLOCKED,CONFLICTED]", "contract": ["synthesis_status", "blockers", "repair_candidates", "unknowns"]},
    {"from": "risk_router", "to": "exact_head_certification", "condition": "route == NO_REPAIR_AND_CANDIDATE_EXISTS", "contract": ["required_gates"]},
    {"from": "risk_router", "to": "remediation_design", "condition": "route == REPAIR", "contract": ["repair_candidates", "required_gates"]},
    {"from": "risk_router", "to": "human_release_authority", "condition": "route == HUMAN_DECISION_ONLY", "contract": ["risk_level", "required_gates"]},
    {"from": "remediation_design", "to": "isolated_implementation", "condition": "repair_plan != null", "contract": ["repair_plan", "changed_file_boundary", "stop_conditions"]},
    {"from": "isolated_implementation", "to": "candidate_verification_cycle", "condition": "candidate_head != null", "contract": ["candidate_head", "changed_files", "implementation_artifacts"]},
    {"from": "candidate_verification_cycle", "to": "exact_head_certification", "condition": "verification_status == PASS", "contract": ["candidate_head", "check_set", "evidence_refs"]},
    {"from": "candidate_verification_cycle", "to": "remediation_design", "condition": "verification_status == REPAIR", "contract": ["failed_checks", "evidence_refs"]},
    {"from": "exact_head_certification", "to": "human_release_authority", "condition": "certification_status == PASS", "contract": ["exact_head", "exact_base", "preview_identity", "governance_state", "evidence_refs"]},
    {"from": "human_release_authority", "to": "production_deployment", "condition": "authorization_status == APPROVED_FOR_EXACT_HEAD", "contract": ["authorized_head", "authorized_scope", "authorization_ref"]},
    {"from": "production_deployment", "to": "live_certification", "condition": "deployment_status == DEPLOYED", "contract": ["deployment_identity", "runtime_version", "deployment_evidence"]},
    {"from": "live_certification", "to": "close_and_persist", "condition": "live_status in [PASS,HOLD,ESCALATE]", "contract": ["live_status", "production_evidence", "residual_risks"]}
  ],
  "release_invariants": [
    "No production mutation without exact-head certification and explicit human authorization.",
    "Candidate generation, verification, approval, and production mutation may not be collapsed into one unreviewed authority context.",
    "A head or base identity change invalidates candidate-bound certification.",
    "Unresolved release-critical evidence cannot be converted to PASS by synthesis.",
    "Deterministic transforms and policy checks must not be replaced by model calls without a documented reason.",
    "Only failed local work is retried; completed independent nodes remain reusable while their authority and freshness remain valid."
  ]
}
