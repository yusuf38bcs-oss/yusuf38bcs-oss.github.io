{
  "version": "1.2.0",
  "name": "LBFL Evidence-Bound Execution Graph",
  "purpose": "Coordinate LBFL research, academic, UI, SEO, accessibility, security, runtime, remediation, certification, and release work with explicit dependencies, durable state, fail-closed gates, bounded retries, deterministic deployment operation identity, and externally recorded human authority.",
  "defaults": {
    "mutation_allowed": false,
    "evidence_states": [
      "VERIFIED",
      "CORROBORATED",
      "INFERRED",
      "UNVERIFIED",
      "CONFLICTED",
      "BLOCKED",
      "STALE",
      "SUPERSEDED",
      "ABSENT"
    ],
    "failure_routes": [
      "RETRY",
      "FALLBACK",
      "SKIP",
      "REPAIR",
      "ESCALATE",
      "HOLD",
      "FAIL_CLOSED",
      "STOP"
    ],
    "max_cycle_rounds": 6,
    "dry_rounds_to_converge": 2,
    "node_classes": [
      "deterministic_gate",
      "specialist_audit",
      "deterministic_join",
      "policy_router",
      "reasoning_node",
      "mutation_node",
      "controlled_cycle",
      "human_gate",
      "state_node"
    ]
  },
  "nodes": [
    {
      "id": "authenticate_baseline",
      "class": "deterministic_gate",
      "job": "Authenticate current repository, branch, SHA/tree, deployment references, and task scope before downstream work.",
      "inputs": [
        "mission",
        "repository_ref",
        "target_environment"
      ],
      "outputs": [
        "authority",
        "scope",
        "evidence_refs",
        "status",
        "target_environment",
        "candidate_head",
        "check_set"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "identity_mismatch": "FAIL_CLOSED",
        "missing_authority": "HOLD",
        "transient_tool_failure": "RETRY"
      },
      "input_sources": {
        "mission": "context",
        "repository_ref": "context",
        "target_environment": "context"
      },
      "retry_policy": {
        "max_attempts": 3,
        "backoff": {
          "strategy": "EXPONENTIAL",
          "initial_delay_ms": 1000,
          "multiplier": 2,
          "max_delay_ms": 8000
        },
        "retryable_failures": [
          "transient_tool_failure"
        ],
        "terminal_route": "HOLD"
      }
    },
    {
      "id": "academic_truth_audit",
      "class": "specialist_audit",
      "job": "Audit scientific accuracy, curriculum alignment, source authority, and unresolved academic claims.",
      "inputs": [
        "authority",
        "scope",
        "audit_plan",
        "candidate_head",
        "check_set",
        "evidence_refs"
      ],
      "outputs": [
        "authority",
        "scope",
        "audit_plan",
        "candidate_head",
        "check_set",
        "audit_result",
        "evidence_refs"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "insufficient_evidence": "HOLD",
        "source_conflict": "ESCALATE",
        "transient_tool_failure": "RETRY"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "audit_plan": "edge",
        "candidate_head": "edge",
        "check_set": "edge",
        "evidence_refs": "edge"
      },
      "retry_policy": {
        "max_attempts": 3,
        "backoff": {
          "strategy": "EXPONENTIAL",
          "initial_delay_ms": 1000,
