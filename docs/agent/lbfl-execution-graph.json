        "candidate_tree",
        "changed_files",
        "implementation_artifacts",
        "expected_evidence",
        "required_gates",
        "evidence_refs"
      ],
      "mutations": {
        "allowed": true,
        "scope": "isolated_candidate_only",
        "production": false
      },
      "failure": {
        "scope_drift": "FAIL_CLOSED",
        "write_conflict": "RETRY",
        "permission_boundary": "STOP"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "repair_plan": "edge",
        "changed_file_boundary": "edge",
