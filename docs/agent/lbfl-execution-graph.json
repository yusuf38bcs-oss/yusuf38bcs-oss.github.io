    {
      "id": "synthesize_findings",
      "class": "deterministic_join",
      "job": "Join every audit selected by audit_plan, reject identity conflicts, normalize evidence, and preserve unresolved evidence.",
      "inputs": [
        "authority",
        "scope",
        "audit_plan",
        "candidate_head",
        "check_set",
        "audit_result",
        "evidence_refs"
      ],
      "outputs": [
        "authority",
        "scope",
        "candidate_head",
        "check_set",
        "synthesis_status",
        "blockers",
        "repair_candidates",
        "evidence_refs",
        "unknowns"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "required_branch_missing": "HOLD",
        "evidence_conflict": "ESCALATE"
      },
      "join_policy": {
        "mode": "all_selected",
        "selector_node": "audit_plan_router",
        "selector_output": "selected_audits",
        "aggregate_inputs": [
          "audit_result",
          "evidence_refs"
        ]
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "audit_plan": "edge",
        "candidate_head": "edge",
        "check_set": "edge",
