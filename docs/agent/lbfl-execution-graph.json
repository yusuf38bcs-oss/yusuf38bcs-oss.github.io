    {
      "id": "exact_head_certification",
      "class": "deterministic_gate",
      "job": "Bind checks, preview, review state, governance evidence, rollout/rollback plans, and a deterministically derived deployment operation identity to the exact candidate head and base.",
      "inputs": [
        "authority",
        "scope",
        "candidate_head",
        "check_set",
        "evidence_refs",
        "required_gates",
        "rollback_plan",
        "rollout_plan"
      ],
      "outputs": [
        "authority",
        "scope",
        "certification_status",
        "exact_head",
        "exact_base",
        "preview_identity",
        "unresolved_threads",
        "governance_state",
        "evidence_refs",
        "rollback_plan",
        "rollout_plan",
        "deployment_operation_id"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "head_or_base_moved": "FAIL_CLOSED",
        "required_check_failed": "HOLD",
        "preview_identity_missing": "HOLD"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "candidate_head": "edge",
        "check_set": "edge",
        "evidence_refs": "edge",
        "required_gates": "edge",
        "rollback_plan": "edge",
        "rollout_plan": "edge"
      },
      "deterministic_outputs": {
        "deployment_operation_id": {
          "algorithm": "SHA-256",
          "canonicalization": "RFC8785",
          "record": {
            "repository": "authority.repository",
            "exact_base": "authority.base_sha",
            "exact_head": "candidate_head",
            "target_environment": "scope.target_environment",
            "rollout_plan": "rollout_plan",
            "rollback_plan": "rollback_plan"
          },
          "encoding": "sha256:<lowercase-hex>",
          "persist_to": "authority.deployment_operation_id"
        }
      }
    },
    {
      "id": "human_release_authority",
      "class": "human_gate",
      "job": "Require an externally recorded durable human approval matching the exact certified head, base, authorized scope, rollout/rollback references, and deterministic deployment operation identity; never synthesize approval from graph execution.",
      "inputs": [
        "authority",
        "scope",
        "certification_status",
        "exact_head",
        "exact_base",
        "preview_identity",
        "unresolved_threads",
        "governance_state",
        "evidence_refs",
        "rollback_plan",
        "rollout_plan",
        "deployment_operation_id",
        "human_approvals"
      ],
      "outputs": [
        "authority",
        "scope",
        "authorization_status",
        "authorized_head",
        "authorized_scope",
        "authorization_ref",
        "rollback_plan",
        "rollout_plan",
        "evidence_refs",
        "deployment_operation_id"
      ],
      "mutations": {
        "allowed": false
      },
      "failure": {
        "authorization_missing": "STOP",
        "head_changed": "FAIL_CLOSED"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "certification_status": "edge",
        "exact_head": "edge",
        "exact_base": "edge",
        "preview_identity": "edge",
        "unresolved_threads": "edge",
        "governance_state": "edge",
        "evidence_refs": "edge",
        "rollback_plan": "edge",
        "rollout_plan": "edge",
        "deployment_operation_id": "edge",
        "human_approvals": "state"
      },
      "external_authority": {
        "state_collection": "human_approvals",
        "required_source": "HUMAN_EXTERNAL",
        "required_decision": "APPROVED_FOR_EXACT_HEAD",
        "match_fields": [
          "source",
          "decision",
          "exact_head",
          "exact_base",
          "authorized_scope",
          "approved_at",
          "authorization_ref",
          "rollback_plan_ref",
          "rollout_plan_ref",
          "deployment_operation_id"
        ]
      }
    },
