        "verification_status",
        "failed_checks",
        "repair_candidates",
        "rounds",
        "required_gates"
      ],
      "mutations": {
        "allowed": true,
        "scope": "isolated_candidate_repair_only",
        "production": false
      },
      "failure": {
        "nonconvergence": "ESCALATE",
        "budget_exhausted": "STOP",
        "identity_changed": "FAIL_CLOSED"
      },
      "convergence": {
        "max_rounds": 6,
        "dry_rounds": 2,
        "completion_test": "verification_status == PASS",
        "budget_ref": "budgets",
        "escalation_route": "ESCALATE"
      },
      "input_sources": {
        "authority": "edge",
        "scope": "edge",
        "candidate_head": "edge",
        "changed_files": "edge",
