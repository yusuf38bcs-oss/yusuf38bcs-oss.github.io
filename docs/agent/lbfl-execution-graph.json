        "backoff": {
          "strategy": "EXPONENTIAL",
          "initial_delay_ms": 1000,
          "multiplier": 2,
          "max_delay_ms": 8000
        },
        "retryable_failures": [
          "write_conflict"
        ],
        "terminal_route": "HOLD"
      }
    },
    {
      "id": "candidate_verification_cycle",
      "class": "controlled_cycle",
      "job": "Run bounded deterministic verification and normalize failures into repair candidates without bypassing exact-head recertification.",
      "inputs": [
        "authority",
        "scope",
        "candidate_head",
        "changed_files",
        "implementation_artifacts",
        "expected_evidence",
        "required_gates",
        "evidence_refs"
