{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synapticai-proxy",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-06-18",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "ALLOWED_ORIGIN": "https://learningbiologyforlife.org",
    "EXTRA_ALLOWED_ORIGINS": "https://www.learningbiologyforlife.org,https://api.learningbiologyforlife.org",
    "ENVIRONMENT": "production"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
