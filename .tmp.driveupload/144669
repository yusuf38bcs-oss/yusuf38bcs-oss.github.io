          <td style="padding: 12px; border: 1px solid rgba(255,255,255,0.05); color: #cbd5e1;">৭০</td>
          <td style="padding: 12px; border: 1px solid rgba(255,255,255,0.05); color: #cbd5e1;">২৮৯০০</td>
